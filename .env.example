# Copy to .env (repo root) and fill in. Never commit .env.
# Both the backend and the frontend's agent routes read this file.

# Groq: gpt-oss-120b, Qwen, gpt-oss-safeguard (free key at https://console.groq.com). GROQ_API_KEY also works.
API_KEY=

# Google AI Studio: Gemma 4 (free key at https://aistudio.google.com/apikey). GEMINI_API_KEY also works.
GEMMA_API_KEY=

# MongoDB Atlas knowledge graph (optional: without it the JSON knowledge base is used)
MONGODB_URI=
# For certificate (X.509) auth, save Atlas's PEM at backend/certs/mongodb-x509.pem or point to it here:
# MONGODB_CERT_PATH=
# MONGODB_DB=meal_planner

# Sentry: one DSN per Sentry project (Settings > Projects > <project> > Client Keys)
SENTRY_DSN=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=qwen/qwen3.8-27b
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_LARGE_MODEL=gemma-4-31b-it
# OLLAMA_MODEL=gemma3:1b             # `ollama pull gemma3:1b` first
# LOCAL_ONLY=false                   # true = plan only with the local Ollama model
# ENABLE_LOCAL_MODELS=true           # set false on servers
# CORS_ORIGINS=https://kilobite.tech
# BACKEND_URL=http://127.0.0.1:8000  # where the agent routes reach FastAPI
# NEXT_PUBLIC_API_URL=http://localhost:8000
